{
  "name": "dsh-mac-pet",
  "description": "DeepSeek Harness status and command bridge for DSH Pet, with a desktop app installation guide and session navigation.",
  "version": "0.9.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundusk/dsh-mac-pet.git"
  },
  "homepage": "https://github.com/sundusk/dsh-mac-pet#readme",
  "bugs": {
    "url": "https://github.com/sundusk/dsh-mac-pet/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "web-ui",
    "dsh-mac-pet",
    "dsh-pet",
    "status",
    "desktop"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown && node scripts/build-client.mjs",
    "test:protocol": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
